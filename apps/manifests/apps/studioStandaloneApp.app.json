{
  "id": "app:studio-standalone",
  "name": "studioStandaloneApp",
  "title": "装配平台独立应用",
  "appType": "standalone",
  "source": "core",
  "status": "enabled",
  "description": "本地唯一手动启动的装配平台独立壳，承载演示工作区、应用、页面和菜单管理页面。",
  "planId": "plan:framework-workbench",
  "loginPageType": "page-login",
  "homePageId": "page:app-management",
  "build": {
    "basePath": "/studioStandaloneApp/",
    "outDir": "dist-app-studio-standalone"
  },
  "runtime": {
    "shellPackage": "@biz/assembly-portal",
    "devCommand": "pnpm -F @biz/assembly-portal dev -- plan:framework-workbench --port 8082",
    "devPort": 8082,
    "basePath": "/studioStandaloneApp",
    "defaultRoute": "/studio/apps",
    "openBehavior": "auto-tab"
  }
}
